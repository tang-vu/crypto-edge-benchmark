{
  "name": "lambda-edge",
  "version": "1.0.0",
  "description": "AWS Lambda@Edge for crypto analytics benchmark",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "esbuild dist/index.js --bundle --platform=node --target=node18 --outfile=dist/bundle.js --format=esm --external:@aws-sdk/*",
    "dev": "npm run build && sam local start-api",
    "deploy": "npm run build && serverless deploy",
    "remove": "serverless remove"
  },
  "dependencies": {
    "@crypto-benchmark/shared": "*"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.131",
    "@types/node": "^20.10.0",
    "esbuild": "^0.19.10",
    "serverless": "^3.38.0",
    "serverless-esbuild": "^1.51.0",
    "typescript": "^5.3.0"
  }
}
